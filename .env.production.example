# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in.
# Never commit the filled-in file.

# Your domain (its DNS A/AAAA record must point at this server) and an email for Let's Encrypt.
DOMAIN=workflowos.example.com
ACME_EMAIL=admin@example.com

# Database password (fixed once the database is created). Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Encryption key for saved integration credentials. Keep a copy somewhere safe: without it,
# saved integrations must be connected again. Generate one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKFLOWOS_SECRET_KEY=

# Sign-in sessions
SESSION_TTL_HOURS=12

# Optional: Prometheus metrics at http://api:8000/metrics inside the Docker network
# (Caddy never serves /metrics). Scrapers send "Authorization: Bearer <token>".
METRICS_TOKEN=

# Optional: Slack channel for operational alerts (can also be set in Settings > Slack).
ALERT_SLACK_CHANNEL=

# Optional: Gemini describes discovered routines (without a key, built-in rules are used).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional fallbacks (prefer Settings > Integrations in the dashboard):
# HUBSPOT_ACCESS_TOKEN=
# SHARED_FOLDER_PATH=/shared   # a folder mounted into the api and worker containers

LOG_FORMAT=json
LOG_LEVEL=INFO
