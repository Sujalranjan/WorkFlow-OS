# WorkFlowOS Environment Configuration Template
# Copy this file to .env and configure local values as needed.

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DATABASE_PATH=workflowos.db

# Desktop Agent Configuration
AGENT_NAME=WorkFlowOS-Desktop-Agent
AGENT_VERSION=0.2.0
BACKEND_API_URL=http://127.0.0.1:8000

# Desktop Activity Collectors (Phase 2)
ENABLE_REAL_COLLECTION=true
WINDOW_POLL_INTERVAL=0.5
WINDOW_DEBOUNCE_SECONDS=0.3
FILE_WATCH_DIRECTORY=watch_folder

# Frontend Configuration
VITE_BACKEND_URL=http://127.0.0.1:8000

# Future Placeholders (Will be configured in subsequent phases)
# AI_PROVIDER_API_KEY=
GEMINI_API_KEY=

# Phase 12 / 12.1 / 15A: Gmail API Configuration (Read-Only)
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_SEARCH_QUERY=from:me
GMAIL_MAX_RESULTS=5

# Phase 15B / 15C: WorkFlowOS Demo CRM Service
CRM_API_BASE_URL=http://127.0.0.1:8001/api/crm
CRM_DATABASE_PATH=crm.db

# Phase 15D: Slack Web API Configuration
# Bot User OAuth Token with 'chat:write' (and 'channels:history' for independent verification)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-placeholder
# Default target Slack channel ID (e.g., C0123456789)
SLACK_CHANNEL_ID=C0123456789