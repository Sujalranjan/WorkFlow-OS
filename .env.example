# WorkFlowOS Environment Configuration Template
# Copy this file to .env and configure local values as needed.

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
# Database: a SQLite file by default. Set DATABASE_URL to use Postgres instead, e.g.
# DATABASE_URL=postgresql+psycopg://workflowos:password@localhost:5432/workflowos
DATABASE_PATH=workflowos.db
# Sign-in
# Dashboard address(es) allowed to call the API with the session cookie (comma separated)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to true when the app is served over HTTPS
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Integration credentials (Gmail, Slack) entered in Settings are stored encrypted.
# Key: WORKFLOWOS_SECRET_KEY, or a key file created next to the database (workflowos.secret.key).
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WORKFLOWOS_SECRET_KEY=
# The API's address in the browser. Register PUBLIC_API_URL/api/integrations/gmail/callback as an
# authorized redirect URI on your Google OAuth client (type: Web application).
PUBLIC_API_URL=http://localhost:8000

# Logging: text (readable, default locally) or json (one object per line; default in Docker)
LOG_FORMAT=text
LOG_LEVEL=INFO

# Desktop Agent Configuration
AGENT_NAME=WorkFlowOS-Desktop-Agent
AGENT_VERSION=0.2.0
BACKEND_API_URL=http://127.0.0.1:8000
# API key for the desktop agent (WorkFlowOS → Settings → API keys); it can only send activity events
WORKFLOWOS_API_KEY=

# Desktop Activity Collectors (Phase 2)
ENABLE_REAL_COLLECTION=true
WINDOW_POLL_INTERVAL=0.5
WINDOW_DEBOUNCE_SECONDS=0.3
FILE_WATCH_DIRECTORY=watch_folder

# Frontend Configuration
VITE_BACKEND_URL=http://127.0.0.1:8000

# Semantic interpretation (optional). Without a key an offline deterministic provider is used.
GEMINI_API_KEY=
# Must be a model name your key can access
GEMINI_MODEL=gemini-3.5-flash-lite

# Gmail (read-only). Preferred: Settings > Integrations > Connect Gmail. The settings below are the
# older file-based alternative (credentials.json + token.json from scripts/gmail_login.py).
GMAIL_ENABLED=false
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_SEARCH_QUERY=from:me
GMAIL_MAX_RESULTS=5

# Email triggers: the server polls enabled triggers in the background (each trigger has its own
# interval, minimum 30s). New matching emails become runs that wait for approval; nothing auto-executes.
TRIGGER_POLLER_ENABLED=true
TRIGGER_POLLER_TICK_SECONDS=15

# Phase 15B / 15C: WorkFlowOS Demo CRM Service
CRM_API_BASE_URL=http://127.0.0.1:8001/api/crm
CRM_DATABASE_PATH=crm.db
# Origin of the Demo CRM browser UI; observed /ui/customers URLs on this origin become CRM actions
CRM_WEB_BASE_URL=http://127.0.0.1:8001

# Slack. Preferred: Settings > Integrations (checked with Slack before saving; overrides these).
# Bot token with 'chat:write' (and 'channels:history' for independent verification)
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CHANNEL_ID=C0123456789
# Tests: live Gemini/Slack/Gmail tests are skipped unless WORKFLOWOS_LIVE_TESTS=1
# WORKFLOWOS_LIVE_TESTS=0
